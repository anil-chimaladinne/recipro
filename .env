# ============================================================
# SKILLSWAP CAMPUS - ENVIRONMENT CONFIGURATION
# ============================================================

# Application
NEXT_PUBLIC_APP_NAME="SkillSwap Campus"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication & Security
AUTH_SECRET="skillswap-super-secret-jwt-key-for-local-development-min32bytes"
TOKEN_EXPIRY="7d"

# Database Configuration
DATABASE_URL="./data/skillswap.db"

# ML Microservice (Python FastAPI)
ML_SERVICE_URL="http://localhost:8000"
ENABLE_ML_FALLBACK="true"

# AI Provider (Optional Gemini / OpenAI key; Deterministic Fallback will run if absent)
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Web3 / Blockchain Configuration
# Uses Sepolia / Hardhat local testnet RPC
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
CHAIN_ID="31337"
NEXT_PUBLIC_CHAIN_ID="31337"
NEXT_PUBLIC_NETWORK_NAME="SkillSwap Local DevNet"
ESCROW_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
CREDENTIAL_CONTRACT_ADDRESS="0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512"
ANCHOR_CONTRACT_ADDRESS="0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0"

# Admin & Moderation Wallet Anchor
ADMIN_WALLET_ADDRESS="0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"

# Anti-Abuse & Rate Limits
MAX_SESSIONS_PER_DAY=10
DEFAULT_STARTER_CREDITS=3
MIN_REPUTATION_FOR_MENTOR=3.0
FRAUD_RISK_THRESHOLD=70
